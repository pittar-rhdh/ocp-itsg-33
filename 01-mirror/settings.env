# shellcheck shell=bash disable=SC2034
# -----------------------------------------------------------------------------
# settings.env: WHERE things live on the low-side mirror workstation.
#
# Defaults only; no secrets. Override any value in settings.local.env next to
# this file (git-ignored), or by exporting the variable before running a script.
# -----------------------------------------------------------------------------

# Root of all low-side mirroring data. Needs a lot of space (see the sizing table
# in docs/01-mirroring/workstation.md). Use a dedicated, encrypted filesystem.
: "${MIRROR_BASE:=/data/mirror}"

# oc-mirror persistent cache. Back it up after every successful run; losing it
# forces a full re-mirror.
: "${MIRROR_CACHE_DIR:=${MIRROR_BASE}/cache}"

# oc-mirror mirror-to-disk destination. Holds working-dir/ (history used for
# incremental runs; keep it) and the mirror_*.tar archives of the latest run.
: "${MIRROR_ARCHIVE_DIR:=${MIRROR_BASE}/archive}"

# Verified binaries, downloaded by 01-download-tools.sh.
: "${MIRROR_TOOLS_DIR:=${MIRROR_BASE}/tools}"

# RHACS offline vulnerability data, downloaded by 06-download-rhacs-db.sh.
: "${MIRROR_RHACS_DIR:=${MIRROR_BASE}/rhacs}"

# Reports (operator channel listings, dry runs).
: "${MIRROR_REPORTS_DIR:=${MIRROR_BASE}/reports}"

# Assembled transfer packages, one directory per transfer.
: "${MIRROR_TRANSFERS_DIR:=${MIRROR_BASE}/transfers}"

# Registry credentials (Red Hat pull secret, in containers auth.json format).
: "${REGISTRY_AUTH_FILE:=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/containers/auth.json}"

# Red Hat release key used to verify signed checksum files from mirror.openshift.com.
: "${RH_RELEASE_KEY:=/etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release}"
: "${CONTENT_BASE_URL:=https://mirror.openshift.com/pub}"

# GPG key (fingerprint or user ID) that signs each transfer's SHA256SUMS.
# Its public key must be provisioned on the high side out of band, never inside
# the transfer it protects.
: "${TRANSFER_SIGNING_KEY:=}"
# Refuse to package an unsigned transfer. Set to false only in a lab.
: "${REQUIRE_TRANSFER_SIGNATURE:=true}"
# Armored PUBLIC key used by 08-verify-transfer.sh to check SHA256SUMS.asc.
: "${TRANSFER_VERIFY_KEY:=}"

# Optional image signature verification during mirroring (oc-mirror --secure-policy).
# See docs/01-mirroring/mirror-to-disk.md before enabling.
: "${MIRROR_VERIFY_SIGNATURES:=false}"
: "${MIRROR_SIGNATURE_POLICY:=}"   # empty = 01-mirror/signature-policy.json

# Free space (GiB) that 02-check-workstation.sh requires under MIRROR_BASE.
: "${MIRROR_MIN_FREE_GB:=500}"
