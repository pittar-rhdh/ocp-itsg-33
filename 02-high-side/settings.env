# shellcheck shell=bash disable=SC2034
# -----------------------------------------------------------------------------
# settings.env: high-side (registry host) settings for Phase 2.
#
# Defaults only; no secrets. Override values in settings.local.env next to this
# file (git-ignored) or by exporting them before running a script. Every
# example.gc.ca value MUST be overridden.
# -----------------------------------------------------------------------------

# --- Registry identity ----------------------------------------------------------
: "${REGISTRY_FQDN:=registry.example.gc.ca}"   # must resolve forward and reverse in DNS
: "${REGISTRY_PORT:=8443}"                      # mirror registry default
# Quay organization that holds all mirrored content (one place to grant access).
: "${MIRROR_NAMESPACE:=mirror}"

# --- TLS (departmental PKI) -------------------------------------------------------
# Server certificate for REGISTRY_FQDN, issued by the departmental PKI.
# The certificate file should contain the server certificate followed by any
# intermediate CA certificates.
: "${TLS_CERT:=/etc/pki/ocp-registry/registry.crt}"
: "${TLS_KEY:=/etc/pki/ocp-registry/registry.key}"
# Root (and intermediate) CA certificates that clients must trust. This bundle
# becomes additionalTrustBundle in install-config.yaml (Phase 3).
: "${TLS_CA_BUNDLE:=/etc/pki/ocp-registry/ca-bundle.crt}"
# Warn when the server certificate expires within this many days.
: "${TLS_EXPIRY_WARN_DAYS:=60}"

# --- mirror registry installation -------------------------------------------------
# Dedicated filesystem for registry data (separate from / and /home).
: "${QUAY_BASE:=/data/quay}"
: "${QUAY_ROOT:=${QUAY_BASE}/install}"          # config bundle, install files
: "${QUAY_STORAGE:=${QUAY_BASE}/storage}"       # image blobs (largest)
: "${QUAY_SQLITE:=${QUAY_BASE}/sqlite}"         # registry database
# Initial (break-glass) registry administrator. Not used for day-to-day pushes.
: "${QUAY_ADMIN_USER:=quayadmin}"
# File (mode 0600) holding the administrator password; 8+ characters, no spaces.
: "${QUAY_ADMIN_PASSWORD_FILE:=${HOME}/.config/ocp-registry/quayadmin.password}"

# --- Registry access (robot accounts) ---------------------------------------------
# OAuth token (file, mode 0600) generated in the registry UI for the
# MIRROR_NAMESPACE organization; used only by 05-configure-registry-access.sh.
: "${QUAY_OAUTH_TOKEN_FILE:=${HOME}/.config/ocp-registry/oauth.token}"
: "${IMPORTER_ROBOT:=importer}"                 # push (write + create) for oc-mirror
: "${CLUSTER_PULL_ROBOT:=cluster_pull}"         # pull-only, for the cluster
# Generated credential files (mode 0600). Keep them off shared storage.
: "${IMPORTER_AUTH_FILE:=${HOME}/.config/ocp-registry/importer-auth.json}"
: "${CLUSTER_PULL_SECRET_FILE:=${HOME}/.config/ocp-registry/cluster-pull-secret.json}"

# --- Imports ------------------------------------------------------------------------
: "${HS_BASE:=/data/ocp}"
: "${HS_TRANSFERS_DIR:=${HS_BASE}/transfers}"       # accepted transfer packages
: "${HS_WORKSPACE:=${HS_BASE}/oc-mirror}"           # disk-to-mirror workspace (keep)
: "${HS_CACHE_DIR:=${HS_BASE}/oc-mirror-cache}"     # oc-mirror cache (keep, back up)
: "${HS_CLUSTER_RESOURCES_DIR:=${HS_BASE}/cluster-resources}"
: "${HS_TOOLS_DIR:=${HS_BASE}/tools}"               # binaries from accepted transfers
: "${HS_INSTALLER_DIR:=${HS_BASE}/installer}"       # extracted openshift-install-fips
: "${HS_RHACS_DIR:=${HS_BASE}/rhacs}"               # RHACS feeds waiting for import (Phase 4)
: "${HS_LEDGER:=${HS_BASE}/imports.tsv}"            # accept/import ledger (evidence)
: "${HS_MIN_FREE_GB:=1000}"                         # free space required under QUAY_BASE

# --- Transfer verification -----------------------------------------------------------
# Armored PUBLIC transfer key, delivered out of band (never inside a transfer).
: "${TRANSFER_VERIFY_KEY:=/etc/pki/ocp-transfer/ocp-transfer-key.pub.asc}"
: "${REQUIRE_TRANSFER_SIGNATURE:=true}"

# --- Departmental Git ------------------------------------------------------------------
: "${GIT_REMOTE_URL:=https://git.example.gc.ca/platform/ocp-itsg-33.git}"
: "${GIT_BRANCH:=main}"
: "${GIT_LOCAL_CLONE:=${HS_BASE}/repo/ocp-itsg-33}"
