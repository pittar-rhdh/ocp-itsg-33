# -----------------------------------------------------------------------------
# BMC credentials EXAMPLE. Copy to BMC_CREDENTIALS_FILE (default
# ~/ocp-install/bmc-credentials.env), set mode 0600, and never commit it.
#
# One username/password pair per host. The variable suffix is the host name in
# upper case with every non-alphanumeric character replaced by "_":
#   openshift-master-0  ->  BMC_USERNAME_OPENSHIFT_MASTER_0
#
# Use a dedicated BMC account per host with the least privilege the installer
# needs, and rotate the passwords after installation (IA-5, AC-6). The cluster
# keeps these credentials as Secrets in openshift-machine-api for Day 2 node
# management.
# -----------------------------------------------------------------------------
BMC_USERNAME_OPENSHIFT_MASTER_0='ocp-install'
BMC_PASSWORD_OPENSHIFT_MASTER_0='change-me'
BMC_USERNAME_OPENSHIFT_MASTER_1='ocp-install'
BMC_PASSWORD_OPENSHIFT_MASTER_1='change-me'
BMC_USERNAME_OPENSHIFT_MASTER_2='ocp-install'
BMC_PASSWORD_OPENSHIFT_MASTER_2='change-me'
BMC_USERNAME_OPENSHIFT_WORKER_0='ocp-install'
BMC_PASSWORD_OPENSHIFT_WORKER_0='change-me'
BMC_USERNAME_OPENSHIFT_WORKER_1='ocp-install'
BMC_PASSWORD_OPENSHIFT_WORKER_1='change-me'
BMC_USERNAME_OPENSHIFT_WORKER_2='ocp-install'
BMC_PASSWORD_OPENSHIFT_WORKER_2='change-me'
