# -----------------------------------------------------------------------------
# Host inventory EXAMPLE for bare-metal IPI with Redfish virtual media and no
# provisioning network (PROVISIONING_METHOD=virtualmedia). Not validated.
#
# Copy to HOSTS_FILE (default ~/ocp-install/hosts.yaml) and edit. The format is
# the platform.baremetal.hosts list of install-config.yaml, except:
#   - bmc.username / bmc.password are left out: the render script adds them from
#     BMC_CREDENTIALS_FILE so this file never holds secrets;
#   - indentation is two spaces from column 0 (the script re-indents it).
#
# Addresses:
#   HPE iLO and most Redfish BMCs:  redfish-virtualmedia://<bmc>/redfish/v1/Systems/1
#   Dell iDRAC:                     idrac-virtualmedia://<bmc>/redfish/v1/Systems/System.Embedded.1
#                                   (Red Hat: redfish-virtualmedia:// does not work on Dell)
# bootMACAddress is required even without a provisioning network.
# rootDeviceHints: prefer a persistent attribute (by-path link or WWN) over
# /dev/sdX, which can change between boots.
# networkConfig (NMState) gives static addressing; Red Hat: a fully static
# deployment requires virtual media. Test each block with `nmstatectl gc`.
# Every node needs forward and reverse (PTR) DNS records.
# bootMode: UEFI with Secure Boot turned on manually in the firmware. Red Hat
# supports manually enabled Secure Boot only with Redfish virtual media;
# "UEFISecureBoot" (managed) is supported only on specific HPE and Dell
# generations - check the 4.22 bare-metal prerequisites before using it.
# -----------------------------------------------------------------------------
- name: openshift-master-0
  role: master
  bmc:
    address: redfish-virtualmedia://10.20.0.10/redfish/v1/Systems/1
    disableCertificateVerification: false
  bootMACAddress: "52:54:00:00:00:10"
  bootMode: UEFI
  rootDeviceHints:
    deviceName: /dev/disk/by-path/pci-0000:00:17.0-ata-1
  networkConfig:
    interfaces:
      - name: eno1
        type: ethernet
        state: up
        mac-address: "52:54:00:00:00:10"
        ipv4:
          enabled: true
          dhcp: false
          address:
            - ip: 10.10.0.10
              prefix-length: 24
        ipv6:
          enabled: false
    dns-resolver:
      config:
        server:
          - 10.10.0.2
    routes:
      config:
        - destination: 0.0.0.0/0
          next-hop-address: 10.10.0.1
          next-hop-interface: eno1
- name: openshift-master-1
  role: master
  bmc:
    address: redfish-virtualmedia://10.20.0.11/redfish/v1/Systems/1
    disableCertificateVerification: false
  bootMACAddress: "52:54:00:00:00:11"
  bootMode: UEFI
  rootDeviceHints:
    deviceName: /dev/disk/by-path/pci-0000:00:17.0-ata-1
  networkConfig:
    interfaces:
      - name: eno1
        type: ethernet
        state: up
        mac-address: "52:54:00:00:00:11"
        ipv4:
          enabled: true
          dhcp: false
          address:
