- name: openshift-master-2
  role: master
  bmc:
    address: idrac-virtualmedia://10.20.0.12/redfish/v1/Systems/System.Embedded.1
    disableCertificateVerification: false
  bootMACAddress: "52:54:00:00:00:12"
  bootMode: UEFI
  rootDeviceHints:
    wwn: "0x5000c500a0b1c2d3"
  networkConfig:
    interfaces:
      - name: eno1
        type: ethernet
        state: up
        mac-address: "52:54:00:00:00:12"
        ipv4:
          enabled: true
          dhcp: false
          address:
            - ip: 10.10.0.12
              prefix-length: 24
        ipv6:
          enabled: false
    dns-resolver:
      config:
        server:
          - 10.10.0.2
    routes:
      config:
        - destination: 0.0.0.0/0
          next-hop-address: 10.10.0.1
          next-hop-interface: eno1
- name: openshift-worker-0
  role: worker
  bmc:
    address: redfish-virtualmedia://10.20.0.20/redfish/v1/Systems/1
    disableCertificateVerification: false
  bootMACAddress: "52:54:00:00:00:20"
  bootMode: UEFI
  rootDeviceHints:
    deviceName: /dev/disk/by-path/pci-0000:00:17.0-ata-1
  networkConfig:
    interfaces:
      - name: bond0
        type: bond
        state: up
        link-aggregation:
          mode: 802.3ad
          port:
            - eno1
            - eno2
        ipv4:
          enabled: true
          dhcp: false
          address:
            - ip: 10.10.0.20
              prefix-length: 24
        ipv6:
          enabled: false
      - name: eno1
        type: ethernet
        state: up
        mac-address: "52:54:00:00:00:20"
      - name: eno2
        type: ethernet
        state: up
        mac-address: "52:54:00:00:00:21"
    dns-resolver:
      config:
        server:
          - 10.10.0.2
    routes:
      config:
        - destination: 0.0.0.0/0
          next-hop-address: 10.10.0.1
          next-hop-interface: bond0
