# -----------------------------------------------------------------------------
# install-config.yaml TEMPLATE for bare-metal IPI in an air-gapped environment.
# EXAMPLE ONLY - not validated against real hardware.
#
# Rendered by 03-install/03-render-install-config.sh. Do not fill it in by hand:
#   double-brace NAME placeholders     values from settings.env / settings.local.env
#   double-brace @NAME placeholders    blocks generated by the render script
# -----------------------------------------------------------------------------
apiVersion: v1
baseDomain: {{BASE_DOMAIN}}
metadata:
  name: {{CLUSTER_NAME}}
# FIPS can only be set at installation. The installer must run on a RHEL 9 host
# in FIPS mode, and must be the FIPS-capable binary (openshift-install-fips).
fips: {{FIPS}}
networking:
  networkType: OVNKubernetes
  machineNetwork:
    - cidr: {{MACHINE_NETWORK_CIDR}}
  clusterNetwork:
    - cidr: {{CLUSTER_NETWORK_CIDR}}
      hostPrefix: {{CLUSTER_NETWORK_HOST_PREFIX}}
  serviceNetwork:
    - {{SERVICE_NETWORK_CIDR}}
controlPlane:
  name: master
  replicas: 3
  hyperthreading: Enabled
  platform:
    baremetal: {}
compute:
  - name: worker
    replicas: {{COMPUTE_REPLICAS}}
    hyperthreading: Enabled
    platform:
      baremetal: {}
platform:
  baremetal:
    apiVIPs:
      - {{API_VIP}}
    ingressVIPs:
      - {{INGRESS_VIP}}
    loadBalancer:
      type: {{LOAD_BALANCER_TYPE}}
    externalBridge: {{EXTERNAL_BRIDGE}}
{{@PROVISIONING}}
{{@BOOTSTRAP}}
{{@NTP}}
{{@BMC_CA}}
    hosts:
{{@HOSTS}}
# Content comes only from the mirror registry (oc-mirror generated IDMS).
{{@IMAGE_DIGEST_SOURCES}}
# Departmental CA that issued the mirror registry certificate.
additionalTrustBundlePolicy: Always
{{@ADDITIONAL_TRUST_BUNDLE}}
# Pull-only robot account for the mirror registry. It has no credentials for
# Red Hat services, so the cluster cannot send Telemetry (AD-08).
pullSecret: '{{@PULL_SECRET}}'
sshKey: '{{@SSH_KEY}}'
