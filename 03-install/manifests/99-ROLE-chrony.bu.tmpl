# EXAMPLE (not validated): chrony configuration for one MachineConfigPool role.
# Red Hat: for disconnected clusters you must configure NTP servers on the nodes.
# Rendered by 04-create-manifests.sh; the server lines come from NTP_SERVERS.
variant: openshift
version: 4.22.0
metadata:
  name: 99-{{ROLE}}-chrony
  labels:
    machineconfiguration.openshift.io/role: {{ROLE}}
storage:
  files:
    - path: /etc/chrony.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
{{CHRONY_SERVERS}}
          driftfile /var/lib/chrony/drift
          makestep 1.0 3
          rtcsync
          logdir /var/log/chrony
