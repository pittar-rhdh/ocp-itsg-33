# EXAMPLE (not validated): LUKS2 encryption of the RHCOS boot disk, bound to the
# node's TPM 2.0 (SC-28). Install time only. Red Hat 4.22: TPM v2 is the
# preferred mode; Tang (NBDE) is supported only for UPI on bare metal and vSphere.
# Butane requires "openshift: fips: true" here when the cluster is FIPS-enabled.
variant: openshift
version: 4.22.0
metadata:
  name: 99-{{ROLE}}-disk-encryption
  labels:
    machineconfiguration.openshift.io/role: {{ROLE}}
boot_device:
  layout: x86_64
  luks:
    tpm2: true
openshift:
  fips: {{FIPS}}
