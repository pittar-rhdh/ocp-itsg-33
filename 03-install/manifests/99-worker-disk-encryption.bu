# EXAMPLE — not validated. LUKS2 encryption of the RHCOS boot disk for the "worker"
# role, bound to the node's TPM 2.0 (SC-28). Install time only. Red Hat 4.22: TPM v2
# is the preferred mode; Tang (NBDE) is supported only for UPI on bare metal and vSphere.
# Butane requires "openshift: fips: true" here when the cluster is FIPS-enabled
# (set it to match "fips" in install-config.yaml). Every node needs TPM 2.0 enabled.
# Convert: butane --strict 99-worker-disk-encryption.bu -o <install-dir>/openshift/99-worker-disk-encryption.yaml
variant: openshift
version: 4.22.0
metadata:
  name: 99-worker-disk-encryption
  labels:
    machineconfiguration.openshift.io/role: worker
boot_device:
  layout: x86_64
  luks:
    tpm2: true
openshift:
  fips: true
