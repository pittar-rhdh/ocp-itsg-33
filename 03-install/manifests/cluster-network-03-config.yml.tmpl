# EXAMPLE (not validated): OVN-Kubernetes IPsec for east-west pod traffic (SC-8).
# Field from the openshift/api operator.openshift.io/v1 Network type
# (spec.defaultNetwork.ovnKubernetesConfig.ipsecConfig.mode: Full|External|Disabled).
# Added to <install-dir>/manifests/ by 04-create-manifests.sh.
apiVersion: operator.openshift.io/v1
kind: Network
metadata:
  name: cluster
spec:
  defaultNetwork:
    type: OVNKubernetes
    ovnKubernetesConfig:
      ipsecConfig:
        mode: {{IPSEC_MODE}}
