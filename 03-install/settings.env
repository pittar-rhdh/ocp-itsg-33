# shellcheck shell=bash disable=SC2034
# -----------------------------------------------------------------------------
# settings.env: cluster and provisioner-host settings for Phase 3 (bare-metal IPI).
#
# EXAMPLE VALUES. Override everything for your environment in
# settings.local.env next to this file (git-ignored) or with exported variables.
# Nothing in this file is a secret: BMC credentials live in BMC_CREDENTIALS_FILE.
# -----------------------------------------------------------------------------

# --- Cluster identity ---------------------------------------------------------------
: "${CLUSTER_NAME:=ocp1}"
: "${BASE_DOMAIN:=example.gc.ca}"

# --- Networks -------------------------------------------------------------------------
: "${MACHINE_NETWORK_CIDR:=10.10.0.0/24}"      # the routable "baremetal" network
: "${CLUSTER_NETWORK_CIDR:=10.128.0.0/14}"     # pods (cannot change after install)
: "${CLUSTER_NETWORK_HOST_PREFIX:=23}"
: "${SERVICE_NETWORK_CIDR:=172.30.0.0/16}"
: "${API_VIP:=10.10.0.5}"                      # must also be api.<cluster>.<domain> in DNS
: "${INGRESS_VIP:=10.10.0.6}"                  # must also be *.apps.<cluster>.<domain> in DNS
# OpenShiftManagedDefault (keepalived/HAProxy on the nodes) or UserManaged (AD-16).
: "${LOAD_BALANCER_TYPE:=OpenShiftManagedDefault}"
# Space-separated departmental NTP servers (names or IPs). Used for pre-install
# clock sync (additionalNTPServers) and for the chrony MachineConfigs.
: "${NTP_SERVERS:=ntp1.example.gc.ca ntp2.example.gc.ca}"

# --- Provisioning method (AD-11) ---------------------------------------------------------
# virtualmedia: no provisioning network; BMCs use redfish-virtualmedia:// or
#               idrac-virtualmedia:// (primary method in this repository)
# pxe:          dedicated, non-routed provisioning network with PXE boot
: "${PROVISIONING_METHOD:=virtualmedia}"
: "${PROVISIONING_NETWORK_CIDR:=172.22.0.0/24}"   # pxe only
: "${EXTERNAL_BRIDGE:=baremetal}"                  # bridge on the provisioner (machine network)
: "${PROVISIONING_BRIDGE:=provisioning}"           # bridge on the provisioner (pxe only)
# virtualmedia only: Red Hat asks for two reserved machine-network addresses for
# the provisioning services when the provisioning network is disabled. The 4.22
# installer treats these fields as optional; set them so the addresses are
# explicit and reserved (both must be in MACHINE_NETWORK_CIDR).
: "${CLUSTER_PROVISIONING_IP:=}"
: "${BOOTSTRAP_PROVISIONING_IP:=}"
# Static addressing for the bootstrap VM when the machine network has no DHCP.
# Leave empty if DHCP serves the machine network.
: "${BOOTSTRAP_STATIC_IP:=}"
: "${BOOTSTRAP_STATIC_GATEWAY:=}"
: "${BOOTSTRAP_STATIC_DNS:=}"

# --- Topology ----------------------------------------------------------------------------
: "${COMPUTE_REPLICAS:=3}"                     # 0 or >= 2 (Red Hat: never exactly 1)

# --- Install-time security settings ------------------------------------------------------
: "${FIPS:=true}"                              # cannot be enabled after installation
: "${DISK_ENCRYPTION:=tpm2}"                   # tpm2 | none  (Tang is UPI-only, see docs)
: "${IPSEC_MODE:=Full}"                        # Full | External | Disabled (AD-05)

# --- Files on the provisioner host --------------------------------------------------------
: "${INSTALL_BASE:=${HOME}/ocp-install}"
# Inputs copied from the registry host (Phase 2 hand-off):
#   release.env, openshift-install-fips, idms-oc-mirror.yaml,
#   cluster-pull-secret.json, ca-bundle.crt, and the oc and butane binaries.
: "${INPUTS_DIR:=${INSTALL_BASE}/inputs}"
# Host inventory (install-config "hosts" format). Start from
# 03-install/hosts.virtualmedia.yaml.example or hosts.pxe.yaml.example.
: "${HOSTS_FILE:=${INSTALL_BASE}/hosts.yaml}"
# BMC credentials (mode 0600, never committed). See bmc-credentials.env.example.
: "${BMC_CREDENTIALS_FILE:=${INSTALL_BASE}/bmc-credentials.env}"
# CA bundle that signed the BMC certificates (empty = use the system trust store).
: "${BMC_CA_BUNDLE:=}"
# SSH public key for the "core" user. In FIPS mode it must be RSA or ECDSA.
: "${SSH_PUBLIC_KEY_FILE:=${HOME}/.ssh/ocp-core_ecdsa.pub}"
# Installation directory (created by the scripts; never reuse one).
: "${INSTALL_DIR:=${INSTALL_BASE}/${CLUSTER_NAME}}"
# Evidence and records produced by the install (kept, Protected B once populated).
: "${EVIDENCE_DIR:=${INSTALL_BASE}/evidence/${CLUSTER_NAME}}"

# --- Optional bootstrap VM image override ---------------------------------------------------
# Only if the installer cannot obtain the bootstrap VM image from the release in
# your environment: an internal HTTP(S) URL with "?sha256=<uncompressed_sha256>".
: "${BOOTSTRAP_OS_IMAGE:=}"
