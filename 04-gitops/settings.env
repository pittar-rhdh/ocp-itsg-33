# shellcheck shell=bash disable=SC2034
# -----------------------------------------------------------------------------
# settings.env: Phase 4 (GitOps and ITSG-33 configuration) settings.
#
# EXAMPLE VALUES. Override them in settings.local.env next to this file
# (git-ignored) or with exported variables. The scripts run on the registry
# host (or another high-side admin host) with KUBECONFIG pointing at the
# cluster. They also read 02-high-side/settings.env for GIT_REMOTE_URL,
# GIT_BRANCH, HS_RHACS_DIR, HS_TOOLS_DIR and the import ledger.
# Nothing in this file is a secret: only paths to files that hold secrets.
# -----------------------------------------------------------------------------

# --- Cluster ----------------------------------------------------------------------
: "${CLUSTER_NAME:=ocp1}"                       # also the overlay name: overlays/<CLUSTER_NAME>
: "${BASE_DOMAIN:=example.gc.ca}"
# oc-mirror v2 CatalogSource name for redhat-operator-index:v<OCP_MINOR>.
: "${CATALOG_SOURCE:=cs-redhat-operator-index-v${OCP_MINOR//./-}}"
: "${GITOPS_NAMESPACE:=openshift-gitops}"

# --- Departmental Git (AD-12) --------------------------------------------------------
# GIT_REMOTE_URL and GIT_BRANCH come from 02-high-side/settings.env.
: "${GIT_CA_FILE:=/etc/pki/ca-trust/source/anchors/dept-root-ca.crt}"   # CA that signed the Git server
: "${GIT_USERNAME:=ocp1-argocd}"                 # read-only deploy account or token name
: "${GIT_TOKEN_FILE:=${HOME}/.config/ocp-gitops/git-token}"             # mode 0600, never committed

# --- Change records and evidence (CM-3, AU-10) -----------------------------------------
# Every install plan approval and secret change is recorded here.
: "${EVIDENCE_DIR:=${HS_BASE:-/data/ocp}/evidence/${CLUSTER_NAME}/phase4}"
# Change ticket for the current action; required by the scripts that change
# the cluster. Export it: CHANGE_ID=CHG0012345 ./02-approve-installplans.sh ...
: "${CHANGE_ID:=}"

# --- Secret inputs for 03-create-secrets.sh ---------------------------------------------
# Files outside Git (mode 0600). Leave a path empty to skip that secret.
: "${SECRETS_DIR:=${HOME}/.config/ocp-gitops/${CLUSTER_NAME}}"
: "${IDP_CLIENT_SECRET_FILE:=${SECRETS_DIR}/gc-sso-client-secret}"    # OIDC client secret (one line)
: "${IDP_CA_FILE:=${SECRETS_DIR}/gc-sso-ca.crt}"                      # IdP CA bundle (PEM, not secret)
: "${LOGIN_TEMPLATE_FILE:=${SECRETS_DIR}/login.html}"                 # from `oc adm create-login-template`, with the AC-8 notice
: "${SIEM_CA_FILE:=${SECRETS_DIR}/siem-ca.crt}"
: "${SIEM_CERT_FILE:=${SECRETS_DIR}/siem-client.crt}"
: "${SIEM_KEY_FILE:=${SECRETS_DIR}/siem-client.key}"
: "${LOKI_S3_ENV_FILE:=${SECRETS_DIR}/loki-s3.env}"                   # access_key_id=, access_key_secret=, bucketnames=, endpoint=, region=
: "${OADP_CREDENTIALS_FILE:=${SECRETS_DIR}/oadp-cloud-credentials}"   # AWS credentials-file format

# --- RHACS (Advanced Cluster Security) ---------------------------------------------------
: "${RHACS_NAMESPACE:=stackrox}"
# Central API endpoint (host:port). Empty = the "central" route in RHACS_NAMESPACE.
: "${ROX_CENTRAL_ADDRESS:=}"
# API token with the Admin role (mode 0600). Empty = use the Central admin
# password from the central-htpasswd secret (initial setup only).
: "${ROX_API_TOKEN_FILE:=}"
# Name recorded for the cluster registration secret (CRS).
: "${RHACS_CRS_NAME:=${CLUSTER_NAME}-crs}"

# --- Offline validation (07-validate.sh) ---------------------------------------------------
# kubeconform schemas. The defaults need internet access (low side, CI). On
# the high side, point them at mirrored copies or leave kubeconform out.
#   KUBECONFORM_K8S_SCHEMAS  "default" (kubernetes-json-schema on GitHub) or a
#                            directory/URL with the same layout
#   KUBECONFORM_CRD_CATALOG  base of a datreeio/CRDs-catalog copy; the script
#                            appends /{Group}/{Kind}_{Version}.json
#   KUBECONFORM_LOCAL_SCHEMAS  directory of {kind}_{version}.json schemas made
#                            from CRDs, for example on the high side from the
#                            cluster itself: oc get crd -o yaml > crds.yaml, then
#                            kubeconform's openapi2jsonschema.py with
#                            FILENAME_FORMAT='{kind}_{version}'
: "${KUBECONFORM_K8S_SCHEMAS:=default}"
: "${KUBECONFORM_LOCAL_SCHEMAS:=}"
: "${KUBECONFORM_CRD_CATALOG:=https://raw.githubusercontent.com/datreeio/CRDs-catalog/main}"
