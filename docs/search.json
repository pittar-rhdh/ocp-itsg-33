---
layout: null
---
[
{% assign doc_pages = site.pages | where_exp: "p", "p.path contains '.md'" %}
{% for p in doc_pages %}
  {
    "title": {{ p.title | default: p.name | jsonify }},
    "url": {{ p.url | replace: '/index.html', '/' | relative_url | jsonify }},
    "path": {{ p.path | jsonify }},
    "content": {{ p.content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
