# shellcheck shell=bash disable=SC2034
# -----------------------------------------------------------------------------
# versions.env: single source of truth for WHAT is mirrored and installed.
#
# Sourced by the scripts in each phase. Change versions here, through a reviewed
# pull request (CM-3), and nowhere else. After changing anything in this file,
# re-render the ImageSetConfiguration and commit both files together:
#   01-mirror/04-render-imageset-config.sh
#
# Local, uncommitted overrides can go in versions.local.env (git-ignored).
# Environment-specific paths (where things are stored) are NOT here; see
# 01-mirror/settings.env.
# -----------------------------------------------------------------------------

# --- OpenShift platform ------------------------------------------------------
OCP_MINOR="4.22"
OCP_CHANNEL="stable-${OCP_MINOR}"   # eus-4.22 if the department standardizes on EUS
OCP_MIN_VERSION="4.22.18"           # lowest z-stream to mirror
OCP_MAX_VERSION="4.22.18"           # highest z-stream to mirror; the install target
OCP_ARCH="amd64"
OCP_MIRROR_GRAPH="true"             # mirror update graph data for OpenShift Update Service

# --- Mirroring ---------------------------------------------------------------
OC_MIRROR_API_VERSION="mirror.openshift.io/v2alpha1"
# Maximum size of each mirror archive file, in GiB. Empty = oc-mirror default.
# Set it to fit the transfer media or the cross-domain solution's file limit.
MIRROR_ARCHIVE_SIZE_GB=""

# --- Tooling -------------------------------------------------------------------
# oc and oc-mirror are downloaded for OCP_MAX_VERSION. openshift-install
# (FIPS-capable) is extracted from the mirrored release on the high side.
MIRROR_REGISTRY_VERSION="2.0.9"     # mirror registry for Red Hat OpenShift
RHACS_VERSION=""                    # roxctl and offline vulnerability data; must match
                                    # the RHACS operator version that is mirrored
BUTANE_VERSION="0.29.0-1"           # Butane, for install-time MachineConfigs (Phase 3)
RHEL_HOST_VERSION="9"               # mirror workstation, registry, and provisioner hosts

# --- Operator catalogs ---------------------------------------------------------
OCP_OPERATOR_CATALOG="registry.redhat.io/redhat/redhat-operator-index:v${OCP_MINOR}"
CERTIFIED_OPERATOR_CATALOG="registry.redhat.io/redhat/certified-operator-index:v${OCP_MINOR}"

# --- Operators -------------------------------------------------------------------
# Format: "package|channels|minVersion|defaultChannel" (last fields optional)
#   package         operator package name in the catalog (required)
#   channels        comma-separated channels; empty = the head bundle of EVERY
#                   channel of the package (oc-mirror v2 behaviour)
#   minVersion      lowest bundle version to keep (from minVersion up to the
#                   channel head). Set it to the version installed on the high
#                   side so the upgrade path is preserved. Empty = heads only.
#   defaultChannel  required by oc-mirror when "channels" does not include the
#                   package's default channel. Find the default channel with
#                   03-list-operator-channels.sh.
# oc-mirror v2 does NOT add dependencies: list every package an operator needs
# (for example, advanced-cluster-management needs multicluster-engine).
# Package names are examples: confirm each one against the live catalog.
OPERATORS=(
  # Platform and bare-metal networking
  "cincinnati-operator||"                     # OpenShift Update Service
  "kubernetes-nmstate-operator||"
  "metallb-operator||"
  # GitOps, governance, and security (OpenShift Platform Plus)
  "openshift-gitops-operator||"
  "advanced-cluster-management||"
  "multicluster-engine||"
  "rhacs-operator||"
  # Security and compliance
  "compliance-operator||"
  "file-integrity-operator||"
  "security-profiles-operator||"
  "openshift-cert-manager-operator||"
  "openshift-external-secrets-operator||"
  # Observability
  "cluster-logging||"
  "loki-operator||"
  "cluster-observability-operator||"
  # Data protection
  "redhat-oadp-operator||"
)

# Vendor CSI driver for the departmental enterprise storage (AD-13), from the
# certified catalog. Same format as OPERATORS. Empty = certified catalog not mirrored.
CSI_OPERATORS=(
  # "<vendor-csi-operator-package>|<channel>|"
)

# --- Additional images ----------------------------------------------------------
# Use a full registry hostname. Prefer @sha256 digests for reproducible imports.
ADDITIONAL_IMAGES=(
  "registry.redhat.io/rhel9/support-tools:latest"   # oc debug / toolbox on RHCOS
  "registry.redhat.io/ubi9/ubi:latest"
  "registry.redhat.io/ubi9/ubi-minimal:latest"
)

# --- AI workloads (backlog; not mirrored yet) -----------------------------------
# See docs/reference/backlog.md. Uncomment and pin when that work starts.
# AI_OPERATORS=(
#   "nfd||"                         # Node Feature Discovery (Red Hat catalog)
#   "gpu-operator-certified||"      # NVIDIA GPU Operator (certified catalog)
#   "rhods-operator||"              # Red Hat OpenShift AI
# )

# Load local overrides last.
_versions_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${_versions_dir}/versions.local.env" ]]; then
  # shellcheck source=/dev/null
  source "${_versions_dir}/versions.local.env"
fi
unset _versions_dir
